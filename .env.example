# ─────────────────────────────────────────────────────
# ZEZELABS BRAIN JARVIS - MASTER ENVIRONMENT TEMPLATE
# ─────────────────────────────────────────────────────

# ─── SECURITY & AUTH ──────────────────────────────────
# JWT secret — üretimde güçlü random string kullanın (python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-64-chars

# Admin panel şifresi (jarvis_admin kullanıcısı için)
ZOM_ADMIN_PASSWORD=change-me-strong-password

# Önceden üretilmiş API anahtarları — üretimde generate_key() ile oluşturun
ZOM_ADMIN_API_KEY=zom_admin_change_me_12345
ZOM_DEPT_API_KEY=zom_dept_change_me_67890
ZOM_READONLY_API_KEY=zom_readonly_change_me

# CORS — virgülle ayrılmış izin verilen origin'ler
# Üretimde sadece kendi domain'inizi yazın, * KULLANMAYIN
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,app://zezelabs

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=
# Shadow CEO alert'lerinin gönderileceği Telegram chat/channel ID
TELEGRAM_CHAT_ID=

# GEMMA MODEL (OpenRouter üzerinden google/gemma-4-26b-a4b-it)
GEMMA_MODEL=google/gemma-4-26b-a4b-it
GEMMA_MODEL_FAST=google/gemma-4-26b-a4b-it
GEMMA_API_BASE=https://openrouter.ai/api/v1
GEMMA_API_KEY=sk-your-openrouter-key-here

# GLM-5.2 — Z.ai / Zhipu AI (MIT lisanslı, 1M token bağlam, agentic coding)
# API anahtarını https://z.ai adresinden edinin
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_CODING_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
# Kullanmak için LLM_MODEL=glm-5.2 veya LLM_MODEL=glm-5.2[1m] yapın
# LLM_MODEL=glm-5.2


# FINANCIAL (ZEZE-FIN)
BINANCE_API_KEY=
BINANCE_SECRET=

# MEDIA & AUTOMATION (ZEZE-MEDIA)
YOUTUBE_API_KEY=
GMAIL_CREDENTIALS_PATH=

# DATABASE & CACHE
REDIS_PASSWORD=your_redis_password
CHROMA_HOST=zezelabs_chroma

# DOCKER INFRA
OPENJARVIS_PATH=.
WORKSPACE_DIR=./workspace

# ZEZE OPERATIONS MANAGER (ZOM)
ZOM_ENABLE_LEGACY_OPENCLAW_CLEANUP=false
ZOM_ENABLE_HERMES_GATEWAY=false
ZOM_ENABLE_AUTO_GITHUB_PUSH=false
ZOM_ENABLE_VOICE_LISTENER=false
ZOM_MOCK_LLAMA=true

# --- Phase: Desktop & Hybrid Orchestration ---
ZOM_AI_MODE=gemma
ZOM_ENABLE_HERMES_SYNC=false
ZOM_ENABLE_DESKTOP_AUTO_BACKEND=true
ZOM_DESKTOP_BACKEND_HOST=127.0.0.1
ZOM_DESKTOP_BACKEND_PORT=8000
ZOM_ENABLE_CLAWDE_OPERATOR=true

# RABBITMQ LIVE BUS CONFIG
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
ZOM_ENABLE_RABBITMQ=false

# HERMES API & BACKGROUND WORKERS
HERMES_API_URL=https://api.hermes.ai
HERMES_API_KEY=

# HEADROOM AI - Output shaping & context compression
HEADROOM_OUTPUT_SHAPER=1

# FREE MODEL CHAIN - basit görevler için sağlık-bilinçli rotasyon zinciri
# Biri 429/402 yerse 60sn cooldown'a alınıp sıradakine kayılır (kalıcı çözüm).
# Virgülle ayrılmış; boş bırakılırsa config.py'daki varsayılan zincir kullanılır.
FREE_MODEL_CHAIN=deepseek/deepseek-r1:free,meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-72b-instruct:free,z-ai/glm-4.5-air:free,mistralai/mistral-small-3.1-24b-instruct:free,meta-llama/llama-3.2-3b-instruct:free
HEADROOM_PROXY_URL=http://127.0.0.1:8787
